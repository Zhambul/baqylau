{
  "name": "baqylau-view-fixture",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12 <23"
  },
  "packageManager": "npm@10.9.8",
  "prettier": "@baqylau/dev-tools/prettier",
  "overrides": {
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "scripts": {
    "build": "vite build",
    "build:host": "vite build --config vite.host.config.ts",
    "check": "svelte-check --tsconfig tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0 && knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@baqylau/extension-api": "0.1.0-alpha.1"
  },
  "devDependencies": {
    "@baqylau/dev-tools": "0.1.0-alpha.1",
    "@playwright/test": "1.62.1",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/node": "22.20.1",
    "eslint": "10.9.0",
    "jsdom": "30.0.1",
    "knip": "6.32.2",
    "prettier": "3.9.6",
    "svelte": "5.56.10",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
